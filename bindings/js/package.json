{
  "name": "@microsoft/termprobe",
  "version": "0.1.1",
  "description": "Node bindings for the termprobe terminal engine",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./test": {
      "types": "./dist/test/index.d.ts",
      "default": "./dist/test/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "native/*.js",
    "native/*.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "nativeTargets": {
    "x86_64-pc-windows-msvc": "win32-x64-msvc",
    "x86_64-apple-darwin": "darwin-x64",
