{
  "name": "@microsoft/termprobe",
  "version": "0.1.1",
  "description": "Node bindings for the termprobe terminal engine",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./test": {
      "types": "./dist/test/index.d.ts",
      "default": "./dist/test/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "native/*.js",
    "native/*.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "nativeTargets": {
    "x86_64-pc-windows-msvc": "win32-x64-msvc",
    "x86_64-apple-darwin": "darwin-x64",
    "aarch64-apple-darwin": "darwin-arm64",
    "x86_64-unknown-linux-gnu": "linux-x64-gnu",
    "aarch64-unknown-linux-gnu": "linux-arm64-gnu",
    "x86_64-unknown-linux-musl": "linux-x64-musl",
    "aarch64-unknown-linux-musl": "linux-arm64-musl"
  },
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "build:native:debug": "node scripts/build-native.mjs --debug",
    "build:ts": "npm run clean && tsc -p tsconfig.json",
    "build": "npm run build:native && npm run build:ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run test:node",
    "test:node": "npm run build && node --test --test-concurrency=1 ./test/conformance.test.mjs ./test/integration.test.mjs ./test/options.test.mjs ./test/native.test.mjs ./test/helpers.test.mjs ./test/scrollback.test.mjs",
    "test:bun": "npm run build && bun test --timeout 60000 ./test/conformance.test.mjs && bun test --timeout 60000 ./test/integration.test.mjs && bun test --timeout 60000 ./test/options.test.mjs && bun test --timeout 60000 ./test/native.test.mjs && bun test --timeout 60000 ./test/helpers.test.mjs && bun test --timeout 60000 ./test/scrollback.test.mjs",
    "test:deno": "npm run build && deno test -A ./test",
